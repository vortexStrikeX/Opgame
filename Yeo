-- Airflow has no built-in search box, so this is a small custom control.
-- It sits above the tab list and filters the tab buttons by name.
local function addSearchBar(window)
    local list = window.TabList
    local sidebar = list and list.Parent
    if not sidebar then
        return
    end

    local colors = Airflow.Theme

    local holder = Instance.new("Frame")
    holder.Name = "SearchBar"
    holder.Position = UDim2.fromOffset(16, 80)
    holder.Size = UDim2.new(1, -32, 0, 32)
    holder.BackgroundColor3 = colors.Surface2
    holder.BorderSizePixel = 0
    holder.Parent = sidebar

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = holder

    local outline = Instance.new("UIStroke")
    outline.Color = colors.Stroke
    outline.Thickness = 1
    outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    outline.Parent = holder

    local icon = Instance.new("ImageLabel")
    icon.AnchorPoint = Vector2.new(0, 0.5)
    icon.Position = UDim2.new(0, 10, 0.5, 0)
    icon.Size = UDim2.fromOffset(14, 14)
    icon.BackgroundTransparency = 1
    icon.ImageColor3 = colors.Muted
    icon.ScaleType = Enum.ScaleType.Fit
    icon.Parent = holder

    local box = Instance.new("TextBox")
    box.Name = "Input"
    box.Position = UDim2.fromOffset(32, 0)
    box.Size = UDim2.new(1, -40, 1, 0)
    box.BackgroundTransparency = 1
    box.Text = ""
    box.PlaceholderText = "Search..."
    box.PlaceholderColor3 = colors.Muted
    box.TextColor3 = colors.Text
    box.TextSize = 13
    box.FontFace = Airflow.Fonts.Regular
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.ClearTextOnFocus = false
    box.ClipsDescendants = true
    box.Parent = holder

    local empty = Instance.new("TextLabel")
    empty.Position = UDim2.fromOffset(16, 130)
    empty.Size = UDim2.new(1, -32, 0, 18)
    empty.BackgroundTransparency = 1
    empty.Text = "No matching tabs"
    empty.TextColor3 = colors.Muted
    empty.TextSize = 12
    empty.FontFace = Airflow.Fonts.Regular
    empty.TextXAlignment = Enum.TextXAlignment.Left
    empty.Visible = false
    empty.Parent = sidebar

    -- Push the tab list down to make room for the search bar.
    list.Position = UDim2.fromOffset(0, 124)
    list.Size = UDim2.new(1, 0, 1, -160)

    box.Focused:Connect(function()
        outline.Color = colors.StrokeHover
    end)
    box.FocusLost:Connect(function()
        outline.Color = colors.Stroke
    end)

    box:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(box.Text)
        local shown = 0
        for _, tab in ipairs(window.Tabs) do
            local match = query == "" or string.find(string.lower(tab.Name), query, 1, true) ~= nil
            tab._button.Visible = match
            if match then
                shown += 1
            end
        end
        empty.Visible = shown == 0

        -- Hide the sidebar divider while a search is active.
        local divider = list:FindFirstChild("TabDivider")
        if divider then
            divider.Visible = query == ""
        end
    end)

    -- Search glyph: same lucide set Airflow already uses for its icons.
    task.spawn(function()
        local ok, set = pcall(function()
            return loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/Icons/refs/heads/main/lucide/dist/Icons.lua"))()
        end)
        if not ok or type(set) ~= "table" then
            return
        end
        local entry = (set.Icons and set.Icons["search"]) or set["search"]
        if type(entry) == "table" then
            local image = entry.Image
            if type(image) == "number" then
                image = "rbxassetid://" .. tostring(image)
            end
            icon.Image = (set.Spritesheets and set.Spritesheets[tostring(image)]) or image
            icon.ImageRectOffset = entry.ImageRectPosition or Vector2.zero
            icon.ImageRectSize = entry.ImageRectSize or Vector2.zero
        elseif type(entry) == "string" then
            icon.Image = entry
        end
    end)
end

