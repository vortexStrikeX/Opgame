end

-- Real world position of an item, whatever it is made of. Models use their
-- parts (not their pivot, which can sit far away from the actual geometry).
local function getItemPosition(item)
    if item:IsA("BasePart") then
        return item.Position
    end
    local handle = item:FindFirstChild("Handle", true)
    if handle and handle:IsA("BasePart") then
        return handle.Position
    end
    if item:IsA("Model") and item.PrimaryPart then
        return item.PrimaryPart.Position
    end
    local low, high
    for _, descendant in ipairs(item:GetDescendants()) do
        if descendant:IsA("BasePart") then
            local p = descendant.Position
            low = low and low:Min(p) or p
            high = high and high:Max(p) or p
        end
    end
    if low and high then
        return (low + high) / 2
    end
    return nil
end

local function isWaterAt(position)
    local ok, result = pcall(function()
        local region = Region3.new(position - Vector3.new(2, 2, 2), position + Vector3.new(2, 2, 2)):ExpandToGrid(4)
        local materials = workspace.Terrain:ReadVoxels(region, 4)
        for x = 1, #materials do
            for y = 1, #materials[x] do
                for z = 1, #materials[x][y] do
                    if materials[x][y][z] == Enum.Material.Water then
                        return true
                    end
                end
            end
        end
        return false
    end)
    return ok and result == true
end

-- Safe Teleport: refuses spots that would drop the player into water or the void.
local function checkLanding(position, item)
    if position.X ~= position.X or position.Y ~= position.Y or position.Z ~= position.Z then
        return false, "invalid position"
    end
    if position.Magnitude < 2 then
        return false, "item is at the world origin"
    end
    if position.Y < -200 then
        return false, "item is below the map"
    end

    local landing = position + Vector3.new(0, config.height, 0)
    if isWaterAt(landing) or isWaterAt(position) then
        return false, "location is in water"
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { item, LocalPlayer.Character }
    local hit = workspace:Raycast(landing, Vector3.new(0, -150, 0), params)
    if not hit then
        return false, "nothing solid below the item"
    end
    if hit.Material == Enum.Material.Water or string.find(string.lower(hit.Instance.Name), "water", 1, true) then
        return false, "item is over water"
    end
    return true
end

-- Moves the character above `position`, keeps its facing, clears fall speed.
local function teleportToPosition(position, item)
    local root = getRoot()
    if not root then
        return false, "no character"
    end
    if config.safe then
        local ok, reason = checkLanding(position, item)
        if not ok then
            return false, reason
        end
    end

    root.CFrame = CFrame.new(position + Vector3.new(0, config.height, 0)) * root.CFrame.Rotation
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    if lastTeleportLabel then
        lastTeleportLabel:Set(string.format(
            "Last teleport: %s  (%d, %d, %d)",
            item.Name,
            math.floor(position.X + 0.5),
            math.floor(position.Y + 0.5),
            math.floor(position.Z + 0.5)
        ))
    end
    return true
end

-- Teleport only (used when "Collect On Select" is off).
local function teleportOnly(label)
    local item = itemMap[label]
    if not (item and item.Parent) then
        notify("Item unavailable", "That item no longer exists.", "Warning")
        return
    end
    local position = getItemPosition(item)
    if not position then
        notify("Can't locate item", item.Name .. " has no physical part to teleport to.", "Warning")
        return
    end
    local ok, reason = teleportToPosition(position, item)
    if not ok then
        notify("Teleport blocked", item.Name .. ": " .. reason .. ". Turn off Safe Teleport to force it.", "Warning")
    end
end

-- Pickup prompts / click detectors (only fired when the executor supports it).
local function getInteractables(item)
    local list = {}
    for _, descendant in ipairs(item:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") or descendant:IsA("ClickDetector") then
            table.insert(list, descendant)
        end
    end
    return list
end

local function fireInteractables(list)
    for _, object in ipairs(list) do
        if object:IsA("ProximityPrompt") then
            if type(fireproximityprompt) == "function" then
                pcall(fireproximityprompt, object)
            end
        elseif type(fireclickdetector) == "function" then
            pcall(fireclickdetector, object)
        end
    end
end

-- Stays on one item until it has been picked up (it leaves the folder).
-- Returns "picked", "timeout", "unsafe", "invalid", "interrupted" or "cancelled".
local function collect(item, folder, token, isPriority)
    local started = os.clock()
    local interactables = getInteractables(item)
    local lastScan, lastTeleport, lastInteract = os.clock(), 0, 0

    while token == runToken do
        if not item:IsDescendantOf(folder) then
            return "picked"
        end
        if not isPriority and #priority > 0 then
            return "interrupted" -- an item was picked in the dropdown
        end

        local now = os.clock()
        local root = getRoot()
        local position = getItemPosition(item)

        if not root then
            started = now -- waiting for a respawn does not count against the timeout
        elseif now - started > config.timeout then
            return "timeout"
        elseif not position then
            return "invalid"
        else
            if (root.Position - position).Magnitude > config.height + 4 and now - lastTeleport >= 0.25 then
                lastTeleport = now
                local ok, reason = teleportToPosition(position, item)
                if not ok then
                    failReason = reason
                    setStatus("Skipped " .. item.Name .. ": " .. reason)
                    return "unsafe"
                end
            end
            if now - lastInteract >= 0.25 then
                lastInteract = now
                if #interactables == 0 and now - lastScan >= 1 then
                    lastScan = now
                    interactables = getInteractables(item)
                end
                fireInteractables(interactables)
            end
        end

        RunService.Heartbeat:Wait()
    end
    return "cancelled"
end

local function nextUnhandled(folder, handled)
    local pick, queue = nil, 0
    for _, item in ipairs(folder:GetChildren()) do
        if not handled[item] then
            queue += 1
            if not pick then
                pick = item
            end
        end
    end
    return pick, queue
end

local function stopRun()
    runToken += 1
    running = false
    sweep = false
    table.clear(priority)
    setStatus("Status: Idle")
end

-- One worker handles everything: dropdown picks first, then (if enabled) every
-- other item. It ends on its own when there is nothing left to do.
local function startRun()
    if running then
        return
    end
    running = true
    runToken += 1
    local token = runToken

    task.spawn(function()
        local handled = setmetatable({}, { __mode = "k" })
        local collected, skipped = 0, 0
        local swept = false

        while token == runToken do
            local folder = getFolder()
            local item, queue, fromPriority

            if folder then
                while #priority > 0 do
                    local candidate = table.remove(priority, 1)
                    if candidate.Parent and candidate:IsDescendantOf(folder) then
                        item, fromPriority = candidate, true
                        break
                    end
                end
                if not item and (sweep or loopMode) then
                    if sweep then
                        swept = true
                    end
                    item, queue = nextUnhandled(folder, handled)
                end
            end

            if item then
                handled[item] = true
                if fromPriority then
                    setStatus("Collecting: " .. item.Name .. "  ·  selected")
                else
                    setStatus("Collecting: " .. item.Name .. "  ·  " .. queue .. " in queue")
                end

                local result = collect(item, folder, token, fromPriority)
                if result == "picked" then
                    collected += 1
                    totalCollected += 1
                    updateCounter()
                    if fromPriority then
                        notify("Collected", item.Name, "Success")
                    end
                elseif result == "interrupted" then
                    handled[item] = nil -- come back to it after the selected item
                elseif result ~= "cancelled" then
                    skipped += 1
                    if fromPriority then
                        if result == "timeout" then
                            notify("Not collected", item.Name .. " was not picked up within " .. config.timeout .. "s.", "Warning")
                        elseif result == "unsafe" then
                            notify("Teleport blocked", item.Name .. ": " .. failReason .. ". Turn off Safe Teleport to force it.", "Warning")
                        else
                            notify("Not collected", item.Name .. " has no physical part to teleport to.", "Warning")
                        end
                    end
                end
            elseif loopMode then
                setStatus("Waiting for new items...")
                task.wait(0.1)
            else
                break
            end
        end

        if token == runToken then
            running = false
            setStatus("Status: Idle")
            if swept and not loopMode then
                notify("Collect finished", "Picked up " .. collected .. "  ·  Skipped " .. skipped, "Success")
            end
            sweep = false
        end
    end)
end

local function onSelect(label)
    if not config.collectOnSelect then
        teleportOnly(label)
        return
    end
    local item = itemMap[label]
    if not (item and item.Parent) then
        notify("Item unavailable", "That item no longer exists.", "Warning")
        return
    end
    table.insert(priority, 1, item)
    if not running then
        startRun()
    end
end

local function onCollectButton()
    if running and (sweep or loopMode) then
        stopRun()
        loopMode = false
        if autoToggle then
            autoToggle:Set(false, true)
        end
        notify("Collect stopped", "Stopped teleporting to items.", "Warning")
        return
    end

    local folder = getFolder()
    if not folder then
        notify("Folder not found", "workspace." .. ITEM_FOLDER_NAME .. " does not exist.", "Error")
        return
    end
    if #folder:GetChildren() == 0 then
        notify("No items", "Nothing is spawned right now.", "Warning")
        return
    end

    sweep = true
    if not running then
        startRun()
    end
end

