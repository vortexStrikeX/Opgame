    -- What is currently allowed to be shown.
    local allEnabled = false
    local selected = {}

    local function allowed(name)
        return allEnabled or selected[name] == true
    end

    local function isActive()
        return allEnabled or next(selected) ~= nil
    end

    local function getGuiParent()
        local ok, ui = pcall(function() return gethui and gethui() end)
        if ok and ui then return ui end
        return game:GetService("CoreGui")
    end

    local function newDrawing(class, props)
        local obj = Drawing.new(class)
        for k, v in pairs(props) do obj[k] = v end
        return obj
    end

    local function matchInstance(inst)
        local info = Lookup[inst.Name:lower()]
        if info then return info end
        if inst:IsA("ProximityPrompt") then
            return Lookup[(inst.ObjectText or ""):lower()] or Lookup[(inst.ActionText or ""):lower()]
        end
    end

    local function resolveTarget(inst)
        if inst:IsA("ProximityPrompt") then
            local p = inst.Parent
            if p and p:IsA("Attachment") then p = p.Parent end
            if p and p:IsA("BasePart") then
                return p:FindFirstAncestorOfClass("Model") or p
            end
            return p
        end
        if inst:IsA("Model") or inst:IsA("BasePart") or inst:IsA("Tool") then
            return inst
        end
    end

    local function getPart(target)
        if target:IsA("BasePart") then return target end
        if target:IsA("Model") then
            return target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
        end
        return target:FindFirstChildWhichIsA("BasePart", true)
    end

    local DRAWING_KEYS = { "tracerGlow", "tracer", "ring", "dot", "edgeArrow", "edgeArrowLine", "edgeText" }

    local function createEntry(target, info)
        if not started or Tracked[target] or not allowed(info.name) then return end

        local part = getPart(target)
        if not part then
