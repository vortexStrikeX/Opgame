-- Rebuilds the dropdown from the folder. Duplicate names get " #2", " #3", ...
local lastSignature = nil
local function rebuild()
    local folder = getFolder()
    local entries = {}
    if folder then
        for index, item in ipairs(folder:GetChildren()) do
            table.insert(entries, { item = item, name = item.Name, index = index })
        end
        table.sort(entries, function(a, b)
            if a.name == b.name then
                return a.index < b.index
            end
            return a.name < b.name
        end)
    end

    local options, map = {}, {}
    for _, entry in ipairs(entries) do
        local label = entry.name
        local n = 1
        while map[label] do
            n += 1
            label = entry.name .. " #" .. n
        end
        map[label] = entry.item
        table.insert(options, label)
    end

    itemMap = map
    countLabel:Set("Items spawned: " .. #options)

    local signature = table.concat(options, "\0")
    if signature == lastSignature then
        return
    end
    lastSignature = signature

    if lastLabel and not map[lastLabel] then
        lastLabel = nil
        itemDropdown:Set(nil, true)
    end
    itemDropdown:Refresh(options, true)
end

-- Rebuilds right away when idle, otherwise at most once per REBUILD_INTERVAL.
local lastBuild, rebuildQueued = 0, false
local function queueRebuild()
    if rebuildQueued then
        return
    end
    rebuildQueued = true
    task.delay(math.max(0, REBUILD_INTERVAL - (os.clock() - lastBuild)), function()
        rebuildQueued = false
        lastBuild = os.clock()
        rebuild()
    end)
end

local folderConnections = {}
local function watchFolder(folder)
    for _, connection in ipairs(folderConnections) do
        connection:Disconnect()
    end
    folderConnections = {
        folder.ChildAdded:Connect(queueRebuild),
        folder.ChildRemoved:Connect(queueRebuild),
    }
    rebuild()
end

rebuild() -- shows the current items immediately
do
    local existing = getFolder()
    if existing then
        watchFolder(existing)
    end
    -- Also covers the folder appearing later or being replaced.
    workspace.ChildAdded:Connect(function(child)
        if child.Name == ITEM_FOLDER_NAME then
            watchFolder(child)
        end
    end)
end

