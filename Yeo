    local function removeEntry(target)
        local e = Tracked[target]
        if not e then return end
        Tracked[target] = nil
        if e.conn then e.conn:Disconnect() end
        if e.highlight then e.highlight:Destroy() end
        if e.gui then e.gui:Destroy() end
        for _, key in ipairs(DRAWING_KEYS) do
            if e[key] then pcall(function() e[key]:Remove() end) end
        end
    end

    local function consider(inst)
        local info = matchInstance(inst)
        if not info or not allowed(info.name) then return end
        local target = resolveTarget(inst)
        if not target then return end
        local model = target:FindFirstAncestorOfClass("Model")
        if model and Players:GetPlayerFromCharacter(model) then return end
        if Players:GetPlayerFromCharacter(target) then return end
        createEntry(target, info)
    end

    local function renderStep()
        Camera = Workspace.CurrentCamera
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local camCF = Camera.CFrame
        local view = Camera.ViewportSize
        local center = view / 2
        local origin = Vector2.new(center.X, view.Y - 4)
        local edgeRadius = math.min(view.X, view.Y) * 0.4
        local t = os.clock()

        for target, e in pairs(Tracked) do
            if e.dead or not target.Parent or not e.part.Parent then
                removeEntry(target)
            else
                local pos = e.part.Position
                local dist = ((root and root.Position or camCF.Position) - pos).Magnitude
                local pulse = (math.sin(t * 3 + e.phase) + 1) / 2

                e.highlight.FillTransparency = 0.72 - pulse * 0.27
                e.stroke.Transparency = 0.4 - pulse * 0.35
                e.distLabel.Text = math.floor(dist) .. "m"

                if e.tracer then
                    local sp, onScreen = Camera:WorldToViewportPoint(pos)
                    if onScreen and sp.Z > 0 then
                        local to = Vector2.new(sp.X, sp.Y)
                        e.edgeArrow.Visible = false
                        e.edgeArrowLine.Visible = false
                        e.edgeText.Visible = false

                        e.tracerGlow.From = origin
                        e.tracerGlow.To = to
                        e.tracerGlow.Transparency = 0.12 + (1 - pulse) * 0.1
                        e.tracerGlow.Visible = true
                        e.tracer.From = origin
                        e.tracer.To = to
                        e.tracer.Visible = true

                        e.ring.Position = to
                        e.ring.Radius = 7 + pulse * 3
                        e.ring.Visible = true
                        e.dot.Position = to
                        e.dot.Visible = true
                    else
                        e.tracerGlow.Visible = false
                        e.tracer.Visible = false
                        e.ring.Visible = false
                        e.dot.Visible = false

                        -- off-screen indicator pointing toward the item
                        local rel = camCF:PointToObjectSpace(pos)
                        local dir = Vector2.new(rel.X, -rel.Y)
                        if dir.Magnitude < 0.001 then dir = Vector2.new(0, 1) end
                        dir = dir.Unit
                        local p = center + dir * edgeRadius
                        local perp = Vector2.new(-dir.Y, dir.X)
                        local tip = p + dir * 14
                        local b1 = p - dir * 6 + perp * 10
                        local b2 = p - dir * 6 - perp * 10

                        e.edgeArrow.PointA = tip
                        e.edgeArrow.PointB = b1
                        e.edgeArrow.PointC = b2
                        e.edgeArrow.Visible = true
                        e.edgeArrowLine.PointA = tip
                        e.edgeArrowLine.PointB = b1
                        e.edgeArrowLine.PointC = b2
                        e.edgeArrowLine.Visible = true

                        e.edgeText.Text = e.name .. " · " .. math.floor(dist) .. "m"
                        e.edgeText.Position = p - dir * 26 - Vector2.new(0, 7)
                        e.edgeText.Visible = true
                    end
                end
            end
        end
    end

    local function start()
        if started then return end
        started = true
        Folder = Instance.new("Folder")
        Folder.Name = "ItemESP"
        Folder.Parent = getGuiParent()

        table.insert(Connections, Workspace.DescendantAdded:Connect(function(d)
            consider(d)
            if d:IsA("ProximityPrompt") then
                task.defer(function() if started then consider(d) end end)
                task.delay(0.3, function() if started then consider(d) end end)
            end
        end))
        table.insert(Connections, RunService.RenderStepped:Connect(renderStep))
    end

    local function stop()
        if not started then return end
        started = false
        scanToken += 1
        for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
        table.clear(Connections)
        for target in pairs(Tracked) do
            removeEntry(target)
        end
        if Folder then
            Folder:Destroy()
            Folder = nil
        end
    end

    -- Applies the current selection: drops what is no longer wanted, then scans
    -- the world for what newly is. The scan yields so it never causes a stutter.
    local function sync()
        if not isActive() then
            stop()
            return
        end
        start()

        for target, e in pairs(Tracked) do
            if not allowed(e.name) then
                removeEntry(target)
            end
        end

        scanToken += 1
        local token = scanToken
        task.spawn(function()
            local count = 0
            for _, d in ipairs(Workspace:GetDescendants()) do
                if token ~= scanToken or not started then return end
                consider(d)
                count += 1
                if count % 1500 == 0 then
                    task.wait()
                end
            end
        end)
    end

    if getgenv then
        if getgenv().ItemESP_Unload then
            pcall(getgenv().ItemESP_Unload)
        end
        getgenv().ItemESP_Unload = function()
            allEnabled = false
            table.clear(selected)
            stop()
        end
    end

    -- ESP: UI --------------------------------------------------------------
    Additional:Section("ESP")

    Additional:Toggle({
        Name = "ESP All The Item",
        Desc = "Shows every item from the list on the map",
        Default = false,
        Callback = function(value)
            allEnabled = value
            sync()
        end,
    })

    Additional:Dropdown({
        Name = "ESP selected items",
        Desc = "Only the items you pick here get an ESP",
        Options = itemNames,
        Multi = true,
        Default = {},
        Callback = function(values)
            table.clear(selected)
            if type(values) == "table" then
                for _, name in ipairs(values) do
                    selected[name] = true
                end
            elseif type(values) == "string" then
                selected[values] = true
            end
            sync()
        end,
    })
end

-- Sidebar divider (between Home and Farm) -------------------------------
-- Airflow's Divider only works inside a page, so this adds a thin line to
-- the sidebar tab list. Run it after all tabs have been created.
local function addTabDivider(window, afterTab)
    local list = window.TabList
    if not list or not afterTab or not afterTab._button then
        return
    end

    local slot = afterTab._button.LayoutOrder

    -- Make room: push every later tab one slot down.
    for _, tab in ipairs(window.Tabs) do
        if tab._button.LayoutOrder > slot then
            tab._button.LayoutOrder += 1
        end
    end

    local divider = Instance.new("Frame")
    divider.Name = "TabDivider"
    divider.Size = UDim2.new(1, 0, 0, 9)
    divider.BackgroundTransparency = 1
    divider.LayoutOrder = slot + 1
    divider.Parent = list

    local line = Instance.new("Frame")
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.Position = UDim2.new(0.5, 0, 0.5, 0)
    line.Size = UDim2.new(1, -8, 0, 1)
    line.BackgroundColor3 = Airflow.Theme.Stroke
    line.BorderSizePixel = 0
    line.Parent = divider
end

addTabDivider(Window, Home)

